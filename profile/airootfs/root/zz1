#!/usr/bin/env sh

function get_cpu_vendor {
    local cpu_vendor=$(cat /proc/cpuinfo | grep 'vendor' | uniq | awk '{ print $3 }')
    local ucode
    case "$cpu_vendor" in
"GenuineIntel")
    ucode="intel-ucode"
    ;;
"AuthenticAMD")
    ucode="amd-ucode"
    ;;
*)
    echo "Unknown cpu vendor $cpu_vendor"
    exit 1
    ;;
esac
    echo "$ucode"
}
# ---------------------------------------------------------------------------------
if [ $# -ne 2 ]; then
    echo 'wrong arguments number'
    echo 'usage: ./zz1 <password> <profile name from profiles directory>'
    exit 1
fi
# ---------------------------------------------------------------------------------
SDIR=$(dirname "$(readlink -f "$0")")
PASSWD=$1
PROFILE=$2
PROFILES_DIR="$SDIR/profiles"
# ---------------------------------------------------------------------------------
if [ ! -f "$SDIR/plain_configuration" ]; then
    [ ! -f "$PROFILES_DIR/$PROFILE" ] && {
        echo "no profile '$PROFILES_DIR/$PROFILE' exists"
        exit 1
    }
    . "$SDIR/decode_configuration.sh" "$PASSWD" "$PROFILE"
fi

set -a
. "$SDIR/plain_configuration"
set +a
# ---------------------------------------------------------------------------------
. ./partition.sh
# ---------------------------------------------------------------------------------
pacman-key --init
pacman-key --populate
# ---------------------------------------------------------------------------------
CFG_ROOT_DEVICE=$(lsblk -p -n -o NAME -x NAME "$CFG_DEVICE" | tail -1)
set -a
CFG_UCODE=$(get_cpu_vendor)
CFG_ROOT_DEVICE_UUID=$(blkid -s UUID -o value "$CFG_ROOT_DEVICE")
set +a

ENV_SUBST=$(printf '${%s} ' $(env | cut -d'=' -f1 | grep '^CFG_'))
# ---------------------------------------------------------------------------------
mkdir -p /mnt/var/lib/pacman
cp -r $SDIR/repo/db/* /mnt/var/lib/pacman/
chmod u+x "$SDIR/pacstrap"
cat "$SDIR/packages" | $SDIR/pacstrap -c -C "$SDIR/pacman.conf" -K /mnt -
# ---------------------------------------------------------------------------------
genfstab -U /mnt >> /mnt/etc/fstab
sed -i 's/relatime/noatime/' /mnt/etc/fstab
# rw,relatime,commit=300
# ---------------------------------------------------------------------------------
find configurations/common/ -type f -print | xargs dirname | sort | uniq | sed 's|^configurations/common|/mnt|' | xargs mkdir -p
for conf in $(find configurations/common/ -type f); do
    cat $conf | envsubst "$ENV_SUBST" > "/mnt${conf#configurations/common}"
done

if [ -d "./configurations/$PROFILE" ]; then
    find "configurations/${PROFILE}/" -type f -print | xargs dirname | sort | uniq | sed "s|^configurations/$PROFILE|/mnt|" | xargs mkdir -p
    for conf in $(find "configurations/${PROFILE}/" -type f); do
        cat "$conf" | envsubst "$ENV_SUBST" > "/mnt${conf#configurations/$PROFILE}"
    done
fi
# ---------------------------------------------------------------------------------
arch-chroot /mnt sh <<EOF
date -u | tee -a /usr/lib/arch.meta
locale-gen
ln -s /usr/share/zoneinfo/Europe/Samara /etc/localtime
hwclock --systohc --utc
printf 'root:$CFG_ROOT_PASSWORD' | chpasswd -e
useradd -m -g users -G audio,video,power,storage,wheel,scanner,network -p '$CFG_USER_PASSWORD' -s /usr/bin/fish $CFG_USERNAME
systemctl enable sshd.service
mkinitcpio -P
EOF
arch-chroot -S /mnt sh <<EOF
bootctl install
[ -n "$CFG_GROUPS" ] && usermod -a -G ${CFG_GROUPS// /,} "$CFG_USERNAME"
[ -n "$CFG_SERVICES" ] && systemctl enable $CFG_SERVICES
EOF
# ---------------------------------------------------------------------------------
SSH_KEYS=$(cat "$SDIR/.ssh/authorized_keys")
arch-chroot /mnt sudo -u "$CFG_USERNAME" sh <<EOF
mkdir -p /home/${CFG_USERNAME}/.ssh
printf "$SSH_KEYS" > /home/${CFG_USERNAME}/.ssh/authorized_keys
EOF
# ---------------------------------------------------------------------------------
